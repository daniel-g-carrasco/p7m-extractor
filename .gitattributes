# Preserve the byte-for-byte copies from signed source archives.
LICENSES/upstream/** -text

# The Windows workflow reads the lock with Bash.
build-aux/windows/*.lock text eol=lf
# the MSYS2 public keyring, byte for byte as in msys2-keyring (its SHA-256 is pinned)
build-aux/windows/msys2-keyring/** -text
