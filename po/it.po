# --- update check -------------------------------------------------------

msgid "GitHub answered {code}"
msgstr "GitHub ha risposto {code}"

msgid "unexpected answer from the server"
msgstr "risposta inattesa dal server"

msgid "cancelled"
msgstr "annullato"

msgid "download failed ({code})"
msgstr "download fallito ({code})"

msgid "the release gives no checksum for the installer: not downloaded"
msgstr "la versione pubblicata non indica l'impronta dell'installer: non è stato scaricato"

msgid "the release gives no signature for the installer: not downloaded"
msgstr "la versione pubblicata non ha la firma dell'installer: non è stato scaricato"

msgid "the installer's signature is not valid: not started"
msgstr "la firma dell'installer non è valida: non è stato avviato"

msgid "the file downloaded does not match the release: not started"
msgstr "il file scaricato non corrisponde alla versione pubblicata: non è stato avviato"

msgid "Installed version: {version}"
msgstr "Versione installata: {version}"

msgid "Update check failed: {error}"
msgstr "Controllo aggiornamenti non riuscito: {error}"

msgid "Available: {version}  ({url})"
msgstr "Disponibile: {version}  ({url})"

msgid "Latest version: {version} (up to date)"
msgstr "Ultima versione: {version} (aggiornato)"

# --- Windows shell integration ------------------------------------------

msgid "Digitally signed document (P7M)"
msgstr "Documento firmato digitalmente (P7M)"

msgid "Extract with P7M Extractor"
msgstr "Estrai con P7M Extractor"

msgid "Extract content with P7M Extractor"
msgstr "Estrai il contenuto con P7M Extractor"

msgid "Extracts the original document from signed .p7m files"
msgstr "Estrae il documento originale dai file firmati .p7m"

# --- CLI ----------------------------------------------------------------

msgid "No .p7m files found."
msgstr "Nessun file .p7m trovato."

msgid "({n} nested signatures)"
msgstr "({n} firme annidate)"

msgid "SKIP  {file}  (already exists: {name}; use --overwrite)"
msgstr "SALTO {file}  (esiste già: {name}; usa --overwrite)"

msgid "Extracted: {ok}  Skipped: {skipped}  Errors: {errors}"
msgstr "Estratti: {ok}  Saltati: {skipped}  Errori: {errors}"

msgid "Extract the original document from .p7m (CAdES) signed files."
msgstr "Estrae il documento originale dai file firmati .p7m (CAdES)."

msgid ""
"Without arguments the graphical interface (GTK 4) starts. Examples: p7m-"
"extractor invoice.xml.p7m | p7m-extractor --overwrite folder/"
msgstr ""
"Senza argomenti si avvia l'interfaccia grafica (GTK 4). Esempi: p7m-"
"extractor fattura.xml.p7m | p7m-extractor --overwrite cartella/"

msgid "FILE_OR_FOLDER"
msgstr "FILE_O_CARTELLA"

msgid ".p7m files or folders to scan (recursive)"
msgstr "file .p7m o cartelle da scansionare (ricorsivo)"

msgid "overwrite existing extracted files"
msgstr "sovrascrivi i file estratti già esistenti"

msgid "force the graphical interface"
msgstr "forza l'avvio dell'interfaccia grafica"

msgid "check whether a newer version exists and exit"
msgstr "controlla se esiste una versione più recente ed esci"

msgid "(Windows) register the app in File Explorer for the current user and exit"
msgstr "(Windows) registra l'app in Esplora file per l'utente corrente ed esci"

msgid "(Windows) remove the registration and exit"
msgstr "(Windows) rimuovi la registrazione ed esci"

msgid "Option available on Windows only."
msgstr "Opzione disponibile solo su Windows."

msgid "File Explorer integration registered for the current user."
msgstr "Integrazione con Esplora file registrata per l'utente corrente."

msgid "File Explorer integration removed for the current user."
msgstr "Integrazione con Esplora file rimossa per l'utente corrente."

msgid "GTK 4 / PyGObject not available. Install:"
msgstr "GTK 4 / PyGObject non disponibili. Installa:"

msgid "or download the portable build from the GitHub Releases."
msgstr "oppure scarica la build portable dalle Release su GitHub."

msgid "Headless use:  p7m-extractor FILE_OR_FOLDER..."
msgstr "Uso senza GUI:  p7m-extractor FILE_O_CARTELLA..."

# --- main window --------------------------------------------------------

msgid "Queued"
msgstr "In coda"

msgid "Open folder"
msgstr "Apri la cartella"

msgid "Extracting…"
msgstr "Estrazione in corso…"

msgid "Extracting… {percent}%"
msgstr "Estrazione in corso… {percent}%"

msgid "Extracted{extra} → {name}"
msgstr "Estratto{extra} → {name}"

msgid "Extraction skipped: the extracted file already exists (enable Overwrite)"
msgstr "Estrazione saltata: il file estratto esiste già (attiva Sovrascrivi)"

msgid "Error: {error}"
msgstr "Errore: {error}"

msgid "Check for updates…"
msgstr "Controlla aggiornamenti…"

msgid "Preferences"
msgstr "Preferenze"

msgid "About {app}"
msgstr "Informazioni su {app}"

msgid "Main menu (F10)"
msgstr "Menu principale (F10)"

msgid "Close"
msgstr "Chiudi"

msgid "Drop .p7m files or folders here"
msgstr "Trascina qui file o cartelle .p7m"

msgid "The original document is extracted next to the signed file"
msgstr "Il documento originale viene estratto accanto al file firmato"

msgid "Choose files…"
msgstr "Scegli file…"

msgid "Choose folder…"
msgstr "Scegli cartella…"

msgid "Extracted files will appear here"
msgstr "I file estratti appariranno qui"

msgid "Overwrite existing files"
msgstr "Sovrascrivi i file già esistenti"

msgid "Extracts the original document from digitally signed files (.p7m, CAdES)."
msgstr "Estrae il documento originale dai file firmati digitalmente (.p7m, CAdES)."

msgid "Project on GitHub"
msgstr "Progetto su GitHub"

msgid "Checking for updates…"
msgstr "Controllo aggiornamenti in corso…"

msgid "Version {version} of {app} is available."
msgstr "È disponibile la versione {version} di {app}."

msgid "Update…"
msgstr "Aggiorna…"

msgid "{app} {version} is up to date: no newer version."
msgstr "{app} {version} è aggiornato: nessuna nuova versione."

msgid "Cannot open {name}: {error}"
msgstr "Impossibile aprire {name}: {error}"

msgid "Choose .p7m files"
msgstr "Scegli file .p7m"

msgid "Signed files (*.p7m)"
msgstr "File firmati (*.p7m)"

msgid "All files"
msgstr "Tutti i file"

msgid "Open"
msgstr "Apri"

msgid "Cancel"
msgstr "Annulla"

msgid "Choose a folder"
msgstr "Scegli una cartella"

msgid "{ok} extracted · {skipped} skipped · {errors} errors"
msgstr "{ok} estratti · {skipped} saltati · {errors} errori"

# --- default app prompt (Windows) ---------------------------------------

msgid "Default app"
msgstr "App predefinita"

msgid "Open .p7m files with {app}?"
msgstr "Vuoi aprire i file .p7m con {app}?"

msgid ""
"Double-clicking a signed file extracts the original document right away, "
"next to the original. You can change your mind at any time in Windows "
"Settings."
msgstr ""
"Con un doppio clic su un file firmato il documento originale viene estratto "
"subito, accanto all'originale. Puoi cambiare idea in qualsiasi momento dalle "
"Impostazioni di Windows."

msgid "Don't ask again"
msgstr "Non chiedere più"

msgid "Not now"
msgstr "Non ora"

msgid "Set as default"
msgstr "Imposta come predefinita"

msgid "Could not set the default: {error}"
msgstr "Impostazione non riuscita: {error}"

msgid "{app} is now the default app for .p7m files."
msgstr "{app} è ora l'app predefinita per i file .p7m."

msgid "In the Settings page that just opened, choose {app} for .p7m."
msgstr "Nella pagina Impostazioni appena aperta scegli {app} alla voce .p7m."

# --- update dialog (Windows) --------------------------------------------

msgid "Update available"
msgstr "Aggiornamento disponibile"

msgid "{app} {version} is available"
msgstr "{app} {version} è disponibile"

msgid "You are using version {version}."
msgstr "Stai usando la versione {version}."

msgid "Later"
msgstr "Più tardi"

msgid "Download and install"
msgstr "Scarica e installa"

msgid "The installation replaces the current version; the app closes and opens again."
msgstr "L'installazione sostituisce la versione attuale; il programma si chiude e si riapre."

msgid "Open the download page"
msgstr "Apri la pagina di download"

msgid "Downloading…"
msgstr "Scaricamento in corso…"

msgid "Download failed: {error}"
msgstr "Download non riuscito: {error}"

msgid "Starting the installer…"
msgstr "Avvio dell'installazione…"

msgid "Cannot start the installer: {error}"
msgstr "Impossibile avviare l'installer: {error}"

# --- preferences --------------------------------------------------------

msgid "Automatic (follow the system)"
msgstr "Automatico (segue il sistema)"

msgid "Light"
msgstr "Chiaro"

msgid "Dark"
msgstr "Scuro"

msgid "Automatic (system language)"
msgstr "Automatica (lingua di sistema)"

msgid "Appearance"
msgstr "Aspetto"

msgid "Theme"
msgstr "Tema"

msgid "“Automatic” follows the system settings"
msgstr "«Automatico» segue le impostazioni di sistema"

msgid "Language"
msgstr "Lingua"

msgid "Takes effect at the next start"
msgstr "Ha effetto al prossimo avvio"

msgid "Windows title bar"
msgstr "Barra del titolo di Windows"

msgid "Needed to snap the window to the screen edges (takes effect at the next start)"
msgstr "Serve ad agganciare la finestra ai bordi dello schermo (ha effetto al prossimo avvio)"

msgid "General"
msgstr "Generale"

msgid "Ask to become the default app at start-up"
msgstr "Chiedi di impostare come app predefinita all'avvio"

msgid "Only until {app} already opens .p7m files"
msgstr "Solo finché {app} non è già l'app che apre i file .p7m"

msgid "Check for updates at start-up"
msgstr "Controlla aggiornamenti all'avvio"

msgid "Once a day, from the project's GitHub Releases"
msgstr "Una volta al giorno, dalle Release del progetto su GitHub"

msgid "File Explorer"
msgstr "Esplora file"

msgid "Set…"
msgstr "Imposta…"

msgid "Default app for .p7m files"
msgstr "App predefinita per i file .p7m"

msgid "Register"
msgstr "Registra"

msgid "Remove"
msgstr "Rimuovi"

msgid "Context menu and “Open with”"
msgstr "Menu contestuale e «Apri con»"

msgid "“Extract content” entry on .p7m files and presence in the app list (current user)"
msgstr "Voce «Estrai il contenuto» sui file .p7m e presenza nell'elenco delle app (utente corrente)"

msgid "The new language will be used at the next start."
msgstr "La nuova lingua sarà attiva al prossimo avvio."

msgid "Currently: {app}"
msgstr "Attualmente: {app}"

msgid "Currently: no app"
msgstr "Attualmente: nessuna app"

msgid "File Explorer integration registered."
msgstr "Integrazione con Esplora file registrata."

msgid "Registration failed: {error}"
msgstr "Registrazione non riuscita: {error}"

msgid "File Explorer entries removed for the current user."
msgstr "Voci di Esplora file rimosse per l'utente corrente."

msgid "Removal failed: {error}"
msgstr "Rimozione non riuscita: {error}"

msgid "Valid signature, with a qualified certificate on a secure device"
msgstr "Firma valida, con certificato qualificato su dispositivo sicuro"

msgid "Valid signature, with a qualified certificate"
msgstr "Firma valida, con certificato qualificato"

msgid "Valid signature (not with a qualified certificate)"
msgstr "Firma valida (non con un certificato qualificato)"

msgid "Not valid: {why}"
msgstr "Non valida: {why}"

msgid "Not established: {why}"
msgstr "Non stabilito: {why}"

msgid "Intact, and the certifier is in the trusted lists kept; whether the certificate was revoked was not checked (no network)"
msgstr "Integra, e il certificatore è nelle liste di fiducia conservate; la revoca del certificato non è stata controllata (senza rete)"

msgid "Intact; the certificate and its certifier were not checked (no network)"
msgstr "Integra; il certificato e il certificatore non sono stati controllati (senza rete)"

msgid "the document was changed after it was signed"
msgstr "il documento è stato modificato dopo la firma"

msgid "the signature does not match the certificate"
msgstr "la firma non corrisponde al certificato"

msgid "the signature is not written as the standard asks"
msgstr "la firma non è scritta come chiede lo standard"

msgid "the certificate had been revoked when the signature was made"
msgstr "il certificato era già revocato quando è stata fatta la firma"

msgid "the certificate was revoked, and no time stamp proves the signature is older"
msgstr "il certificato è stato revocato, e nessuna marca temporale prova che la firma sia precedente"

msgid "the certifier's certificate was revoked, and no time stamp proves the signature is older"
msgstr "il certificato del certificatore è stato revocato, e nessuna marca temporale prova che la firma sia precedente"

msgid "the certificate had expired when the signature was made"
msgstr "il certificato era già scaduto quando è stata fatta la firma"

msgid "the certificate has expired, and no time stamp proves the signature is older"
msgstr "il certificato è scaduto, e nessuna marca temporale prova che la firma sia precedente"

msgid "the certificate was not valid yet when the signature was made"
msgstr "il certificato non era ancora valido quando è stata fatta la firma"

msgid "the certifier is not in the trusted lists"
msgstr "il certificatore non è nelle liste di fiducia"

msgid "the signer's certificate is not in the file"
msgstr "il certificato del firmatario non è nel file"

msgid "the certifier did not say whether the certificate is revoked: try again later"
msgstr "il certificatore non ha detto se il certificato è revocato: riprova più tardi"

msgid "the certificate's chain could not be checked"
msgstr "la catena del certificato non si è potuta controllare"

msgid "the signature uses an algorithm no longer held safe"
msgstr "la firma usa un algoritmo non più ritenuto sicuro"

msgid "the trusted lists could not be had"
msgstr "non è stato possibile avere le liste di fiducia"

msgid "whether the certificate was revoked could not be established"
msgstr "non è stato possibile stabilire se il certificato è stato revocato"

msgid "unknown reason"
msgstr "motivo sconosciuto"

msgid "(no name in the certificate)"
msgstr "(nessun nome nel certificato)"

msgid "Checked by this program, which is not a qualified validation service."
msgstr "Controllo fatto da questo programma, che non è un servizio di convalida qualificato."

msgid "This build cannot verify signatures: the pyHanko library is missing."
msgstr "Questa versione non può verificare le firme: manca la libreria pyHanko."

msgid "check the signatures of the files and say who signed, instead of extracting"
msgstr "controlla le firme dei file e dice chi ha firmato, invece di estrarre"

msgid "with --verify: do not use the network (integrity only, and the trusted lists kept)"
msgstr "con --verify: non usare la rete (solo l'integrità, e le liste di fiducia conservate)"

msgid "Without the network: revocations were not checked."
msgstr "Senza rete: le revoche non sono state controllate."

msgid "No trusted lists kept: certifiers were not looked up."
msgstr "Nessuna lista di fiducia conservata: i certificatori non sono stati cercati."

msgid "Trusted lists kept {days} days ago."
msgstr "Liste di fiducia conservate {days} giorni fa."

msgid "Signatures…"
msgstr "Firme…"


msgid "Signatures"
msgstr "Firme"

msgid "Verify the signatures"
msgstr "Verifica le firme"

msgid "Asks the European trusted lists and the certifier; no document leaves the computer"
msgstr "Interroga le liste di fiducia europee e il certificatore; nessun documento esce dal computer"

msgid "Intact"
msgstr "Integra"

msgid "Valid"
msgstr "Valida"

msgid "Not established"
msgstr "Non stabilito"

msgid "Not valid"
msgstr "Non valida"

msgid "Signature on the document"
msgstr "Firma sul documento"

msgid "Innermost signature · on the document"
msgstr "Firma più interna · apposta sul documento"

msgid "Outermost signature · on the file already signed"
msgstr "Firma più esterna · apposta sul file già firmato"

msgid "Signature {n} of {total} from the outside · on the file already signed"
msgstr "Firma {n} di {total} dall'esterno · apposta sul file già firmato"

msgid "Signed by"
msgstr "Firmato da"

msgid "One signature"
msgstr "Una firma"

msgid "No signature found"
msgstr "Nessuna firma trovata"

msgid "Organisation"
msgstr "Organizzazione"

msgid "Identifier"
msgstr "Identificativo"

msgid "Certifier"
msgstr "Certificatore"

msgid "Certificate valid"
msgstr "Validità del certificato"

msgid "Time of signing"
msgstr "Data della firma"

msgid "; at that time the certificate was within its dates"
msgstr "; a quella data il certificato era nelle sue date di validità"

msgid "All valid"
msgstr "Tutte valide"

msgid "{when}, written by the signer and not proven by a time stamp"
msgstr "{when}, scritta dal firmatario e non provata da una marca temporale"

msgid "not in the file"
msgstr "non presente nel file"

msgid "Trusted lists"
msgstr "Liste di fiducia"

msgid "the certificate calls itself qualified; its certifier could not be looked up"
msgstr "il certificato si dichiara qualificato; il certificatore non si è potuto cercare"

msgid "certifier found in the European lists, as qualified for signatures"
msgstr "certificatore trovato nelle liste europee, come qualificato per le firme"

msgid "certifier not found in the European lists"
msgstr "certificatore non trovato nelle liste europee"

msgid "{n} signatures, one inside the other"
msgstr "{n} firme, una dentro l'altra"

msgid "{n} signatures in {layers} envelopes, one inside the other"
msgstr "{n} firme in {layers} buste, una dentro l'altra"

msgid "{n} signatures, side by side"
msgstr "{n} firme, affiancate"

msgid "{name}: {summary}"
msgstr "{name}: {summary}"

msgid "from {start} to {end}"
msgstr "dal {start} al {end}"

msgid "{when}, proven by a time stamp"
msgstr "{when}, provata da una marca temporale"

msgid "Outcome"
msgstr "Esito"

msgid "The document that was signed"
msgstr "Il documento che è stato firmato"

msgid "Trusted lists of today."
msgstr "Liste di fiducia di oggi."

msgid "Signature: waiting to be checked"
msgstr "Firma: in attesa del controllo"

msgid "Signature: being checked…"
msgstr "Firma: controllo in corso…"

msgid "Signature: could not be checked"
msgstr "Firma: non è stato possibile controllarla"
